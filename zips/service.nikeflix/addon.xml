<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.nikeflix" name="NikeFlix Service" version="0.2.8" provider-name="NikeFlix">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.service" library="service.py" start="login"/>
  <extension point="xbmc.python.script" library="script.py"/>
  <extension point="xbmc.python.pluginsource" library="plugin.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">NikeFlix core service: playback routing (Umbrella primary, Fen 4 fallback) and profile isolation guard</summary>
    <description lang="en_GB">Part of NikeFlix. Later tasks add the Trakt Hub broker, Quiet Mode, continuation, weather repair, intro-once and shutdown helpers.</description>
    <platform>all</platform>
    <license>GPL-3.0-or-later</license>
  </extension>
</addon>
